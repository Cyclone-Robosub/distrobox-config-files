# --- micro-ROS agent builder stage ---
FROM docker.io/microros/micro-ros-agent:jazzy AS microros_agent

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
ARG TARGETARCH

# Prevents buildx network timeouts and speed up install
RUN echo 'Acquire::Retries "10";' > /etc/apt/apt.conf.d/80retries \
    && echo 'Acquire::http::Timeout "120";' >> /etc/apt/apt.conf.d/80retries \
    && echo 'Acquire::Queue-Mode "access";' >> /etc/apt/apt.conf.d/80retries \                                                      
    && echo 'Acquire::http::Pipeline-Depth "10";' >> /etc/apt/apt.conf.d/80retries   

# Core packages
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y \
    wget gpg apt-transport-https ca-certificates curl \
    software-properties-common && \
    add-apt-repository ppa:maveonair/helix-editor  && \
    apt-get install -y git vim tmux btop gcc g++ make \ 
    cmake ffmpeg neofetch curl jq \
    libudev1 libudev-dev libboost-all-dev \
    unzip v4l-utils \
    vim nano helix \ 
    i2c-tools \
    && rm -rf /var/lib/apt/lists/*

# Lazygit if VSCode doesn't work
RUN case "${TARGETARCH}" in \
        amd64) LAZYGIT_ARCH="x86_64" ;; \
        arm64) LAZYGIT_ARCH="arm64" ;; \
        *) echo "Unsupported TARGETARCH: ${TARGETARCH}" && exit 1 ;; \
    esac \
    && LAZYGIT_VERSION=$(curl -s "https://api.github.com/repos/jesseduffield/lazygit/releases/latest" | grep -Po '"tag_name": *"v\K[^"]*') \
    && curl -Lo /tmp/lazygit.tar.gz "https://github.com/jesseduffield/lazygit/releases/download/v${LAZYGIT_VERSION}/lazygit_${LAZYGIT_VERSION}_Linux_${LAZYGIT_ARCH}.tar.gz" \
    && tar -xf /tmp/lazygit.tar.gz -C /tmp lazygit \
    && install /tmp/lazygit -D -t /usr/local/bin/ \
    && rm -f /tmp/lazygit.tar.gz /tmp/lazygit

# ROS2 Jazzy - add apt source
RUN export ROS_APT_SOURCE_VERSION=$(curl -s https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest | jq -r .tag_name) \
    && curl -L -o /tmp/ros2-apt-source.deb \
    "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.$(. /etc/os-release && echo ${UBUNTU_CODENAME:-${VERSION_CODENAME}})_all.deb" \
    && dpkg -i /tmp/ros2-apt-source.deb \
    && rm -rf /tmp/ros2-apt-source.deb

# ROS2 Jazzy - install packages
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --fix-missing \
    ros-dev-tools ros-jazzy-ros-base ros-jazzy-rosbridge-server \
    ros-jazzy-behaviortree-cpp ros-jazzy-generate-parameter-library \
    && rm -rf /var/lib/apt/lists/*

# VS Code
RUN echo "code code/add-microsoft-repo boolean true" | debconf-set-selections \
    && wget -qO- https://packages.microsoft.com/keys/microsoft.asc \
    | gpg --dearmor > /usr/share/keyrings/microsoft.gpg \
    && printf "Types: deb\nURIs: https://packages.microsoft.com/repos/code\nSuites: stable\nComponents: main\nArchitectures: amd64,arm64,armhf\nSigned-By: /usr/share/keyrings/microsoft.gpg\n" \
    > /etc/apt/sources.list.d/vscode.sources \
    && apt-get update && apt-get install -y code \
    && rm -rf /var/lib/apt/lists/*

# Install uv
ADD https://astral.sh/uv/install.sh /uv-installer.sh

# Run the installer then remove it
RUN sh /uv-installer.sh && rm /uv-installer.sh

# Bun
RUN export BUN_INSTALL=/opt/bun && mkdir /opt/bun && curl -fsSL https://bun.sh/install | bash

# MediaMTX
RUN arch=$(arch | sed s/aarch64/arm64/ | sed s/x86_64/amd64/) && mkdir /opt/mediaMTX && wget -P /opt/mediaMTX https://github.com/bluenviron/mediamtx/releases/download/v1.18.1/mediamtx_v1.18.1_linux_${arch}.tar.gz && tar -xzf /opt/mediaMTX/mediamtx_v1.18.1_linux_${arch}.tar.gz -C /opt/mediaMTX && rm /opt/mediaMTX/mediamtx_v1.18.1_linux_${arch}.tar.gz

# Copy the pre-built micro-ROS agent workspace
COPY --from=microros_agent /uros_ws /uros_ws
COPY --from=microros_agent /opt/ros/jazzy /opt/ros/jazzy-agent
